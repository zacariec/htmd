{
  "name": "@htmdjs/renderer",
  "version": "0.1.0-alpha.2",
  "description": "Framework-agnostic DOM materializer for .htmd — static render and streaming region trees",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zacariec/htmd.git",
    "directory": "packages/renderer"
  },
  "homepage": "https://github.com/zacariec/htmd#readme",
  "bugs": {
    "url": "https://github.com/zacariec/htmd/issues"
  },
  "keywords": ["htmd", "ai", "streaming", "renderer", "markdown", "dom"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@htmdjs/contracts": "workspace:*",
    "@htmdjs/parser": "workspace:*",
    "@htmdjs/wire": "workspace:*",
    "micromark": "^4.0.1",
    "micromark-extension-gfm": "^3.0.0"
  },
  "devDependencies": {
    "@htmdjs/elements": "workspace:*",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
